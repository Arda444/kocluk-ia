# Yerel SQLite (Prisma) — canlıya Turso panel linki yazma
DATABASE_URL="file:./dev.db"

# Auth.js — `openssl rand -hex 32` ile üret
AUTH_SECRET="replace-with-a-long-random-string"
# Yalnızca bu makine: npm run dev. Vercel'e localhost yazma.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Groq ücretsiz API: https://console.groq.com
GROQ_API_KEY=""

# Canlı (Vercel dashboard, Production) — bu dosyayı Vercel'e kopyalama
# AUTH_URL="https://kocluk-ia.vercel.app"
# TURSO_DATABASE_URL="libsql://....turso.io"
# TURSO_AUTH_TOKEN=""
